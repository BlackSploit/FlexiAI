# PhysioCoach environment template. PLACEHOLDERS ONLY: never put real keys or secrets in this file.
# Copy to .env (root; read by Next.js and by docker compose interpolation) and fill in locally.
# agent/.env is optional and only needed to run the agent outside Docker.
# An empty value always means "unset / use the default".

# ---------- web (Next.js) ----------
DATABASE_URL=

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stream Video app (web reads these names; docker compose copies them to the agent as STREAM_API_KEY / STREAM_API_SECRET)
NEXT_PUBLIC_STREAM_VIDEO_API_KEY=
STREAM_VIDEO_SECRET_KEY=
# "default" until the physio_session call type is verified
STREAM_CALL_TYPE=default
NEXT_PUBLIC_STREAM_AGENT_USER_ID=physiocoach-agent

# openssl rand -base64 32
JOIN_LINK_SECRET=

# Web <-> agent-worker control plane (shared with the worker; generate random values)
AGENT_WORKER_URL=http://localhost:8080
AGENT_CONTROL_SECRET=
AGENT_CALLBACK_SECRET=
# comma-separated allow-list of replay clips, e.g. knee_demo.mp4
AGENT_REPLAY_CLIPS=

# "true" only on the demo deployment (dashboard includes replay sessions)
NEXT_PUBLIC_DEMO_MODE=false
# "true" to allow physio sign-up
ALLOW_SIGNUP=true
# "false" disables the AI weekly summary (the rules summary is always the fallback)
WEEKLY_SUMMARY_LLM_ENABLED=

# ---------- OpenAI (web weekly summary, agent post-set note, Live Coach) ----------
# No key -> rule-based notes/summaries and cached voice clips only; the app works fully without it.
OPENAI_API_KEY=
# Text model (Chat Completions, strict JSON schema) for the post-set note and the weekly summary
OPENAI_MODEL=gpt-5-mini
# minimal | low | medium | high, or "omit" to leave the parameter out. Sent only to reasoning models
# (gpt-5*, o1/o3/o4...); empty = minimal (keeps the note inside its 3.5 s budget)
OPENAI_REASONING_EFFORT=minimal
# Agent only: overrides OPENAI_MODEL for the post-set note
NOTE_LLM_MODEL=

# ---------- Live Coach (agent-worker; OpenAI Realtime speech-to-speech in the call) ----------
# empty = on when OPENAI_API_KEY is set; off/false/0/no = off (kill switch). Falls back to cached clips if it fails.
LIVE_COACH=
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
# Occasional still images of the annotated exercise video to the realtime model (counting stays on pose math)
LIVE_COACH_VIDEO=on
# Forward patient audio during countdown/set so "stop" / symptoms can be heard (the coach stays quiet)
LIVE_COACH_SET_LISTEN=on
# Let the patient interrupt the coach while it talks. Keep off (half-duplex) unless rehearsed in the room
LIVE_COACH_BARGE_IN=off
# Send partial (non-final) transcripts to the call UI, max 1/s
LIVE_COACH_PARTIALS=off
# Transcription language: empty = the patient's language; "auto" lets the model detect it
LIVE_COACH_TRANSCRIBE_LANG=
# Turn detection eagerness: low | medium | high (empty = medium)
LIVE_COACH_VAD_EAGERNESS=

# ---------- agent-worker (Python) ----------
# Only needed outside Docker (compose sets these from the web names above / its own service names)
STREAM_API_KEY=
STREAM_API_SECRET=
WEB_INTERNAL_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
WORKER_HOST=

# Voice / TTS
SARVAM_API_KEY=
# path to a Google service-account JSON (only for TTS_PRIMARY=google)
GOOGLE_APPLICATION_CREDENTIALS=
VOICE_SLUG=dev-espeak-ml
# runtime TTS for free text (LLM notes): sarvam | google | none (clips only)
TTS_PRIMARY=
TTS_PACE=
SARVAM_SPEAKER=
GOOGLE_TTS_VOICE=
PC_VOICE_CACHE=

# Post-set note (LLM note falls back to the rule note on any failure)
NOTE_LLM_ENABLED=true
NOTE_LLM_TIMEOUT_S=3.5
NOTE_TTS_TIMEOUT_S=3.0

# Pose
# mediapipe | yolo
POSE_BACKEND=mediapipe
POSE_FPS=12
POSE_OUT_W=
POSE_OUT_H=

# Sessions
MAX_SESSIONS=2
PATIENT_JOIN_TIMEOUT_S=900
BARGEIN_MIN_RMS=0.02
PC_SHARED_DIR=
LOG_LEVEL=
