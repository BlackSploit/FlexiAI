# PhysioCoach environment template. PLACEHOLDERS ONLY: never put real values in this file.
# Copy to .env (web) and agent/.env (agent-worker) and fill in locally.

# ---------- web (Next.js) ----------
DATABASE_URL="postgresql://neondb_owner:npg_YdRU9TIxpz5i@ep-wandering-dream-b8ezm2gk-pooler.c-14.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

BETTER_AUTH_SECRET="replace-with-at-least-32-random-bytes"
BETTER_AUTH_URL="http://localhost:3000"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
# dev only: static ngrok domain, no scheme (e.g. my-domain.ngrok-free.app)
NGROK_DOMAIN=""

NEXT_PUBLIC_STREAM_VIDEO_API_KEY="your-stream-api-key"
STREAM_VIDEO_SECRET_KEY="your-stream-secret"

# "default" until the physio_session call type is verified
STREAM_CALL_TYPE="default"
NEXT_PUBLIC_STREAM_AGENT_USER_ID="physiocoach-agent"

JOIN_LINK_SECRET="replace-with-at-least-32-random-bytes"

AGENT_WORKER_URL="http://localhost:8080"
AGENT_CONTROL_SECRET="replace-with-at-least-32-random-bytes"
AGENT_CALLBACK_SECRET="replace-with-at-least-32-random-bytes"
# comma-separated allow-list of replay clips, e.g. knee_demo.mp4
AGENT_REPLAY_CLIPS=""

ANTHROPIC_API_KEY="your-anthropic-key"
NOTE_LLM_SERVER_FALLBACK="true"

# "true" only on the demo deployment (dashboard includes replay sessions)
NEXT_PUBLIC_DEMO_MODE="false"
# optional: "true" to allow physio sign-up
ALLOW_SIGNUP="true"

# ---------- agent-worker (Python), usually in agent/.env ----------
# Same Stream app as web, under the names getstream 4.x reads
STREAM_API_KEY="your-stream-api-key"
STREAM_API_SECRET="your-stream-secret"
WEB_INTERNAL_URL="http://host.docker.internal:3000"
REDIS_URL="redis://redis:6379/0"
SARVAM_API_KEY="your-sarvam-key"
GOOGLE_APPLICATION_CREDENTIALS="/run/secrets/google-tts.json"
NOTE_LLM_ENABLED="true"
NOTE_LLM_TIMEOUT_S="3.5"
NOTE_TTS_TIMEOUT_S="3.0"
VOICE_SLUG="sarvam-bulbul-v3-SPEAKER-p090"
# runtime TTS for free text (LLM notes): sarvam | google | none (clips only)
TTS_PRIMARY="sarvam"
TTS_PACE="0.9"
PC_VOICE_CACHE="cache/voice"
SARVAM_SPEAKER="shubh"
GOOGLE_TTS_VOICE="ml-IN-Chirp3-HD-Kore"
POSE_BACKEND="mediapipe"
POSE_FPS="12"
POSE_OUT_W="640"
POSE_OUT_H="360"
MAX_SESSIONS="2"
PATIENT_JOIN_TIMEOUT_S="900"
BARGEIN_MIN_RMS="0.02"
PC_SHARED_DIR="/app/shared"
WORKER_HOST="agent-worker-1"
